{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicitizenaction/schema/window.schema.json",
  "title": "Window",
  "description": "A dated, closing opportunity to act: an open consultation, a call for evidence, a hearing, a bill before markup. Expires on closes_on and moves to the archive automatically. Lives in content/resources/windows/<id>.yml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "facts", "strings", "meta"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "opens_on", "closes_on", "jurisdiction"],
      "properties": {
        "url": { "$ref": "common.schema.json#/$defs/url" },
        "opens_on": { "$ref": "common.schema.json#/$defs/date" },
        "closes_on": { "$ref": "common.schema.json#/$defs/date" },
        "jurisdiction": { "$ref": "common.schema.json#/$defs/geo" },
        "accepts_foreign": { "type": "boolean" },
        "language": { "type": "string" },
        "topics": { "$ref": "common.schema.json#/$defs/vocabList" },
        "bodies": { "$ref": "common.schema.json#/$defs/vocabList" },
        "channels": { "$ref": "common.schema.json#/$defs/vocabList" },
        "orgs": { "$ref": "common.schema.json#/$defs/vocabList" },
        "action": { "$ref": "media.schema.json#/$defs/action" }
      }
    },
    "strings": {
      "type": "object",
      "required": ["title", "summary"],
      "properties": { "title": { "type": "string" }, "summary": { "type": "string" }, "how": { "type": "string" } }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_on", "review_by", "sources"],
      "properties": {
        "verified_on": { "$ref": "common.schema.json#/$defs/date" },
        "review_by": { "$ref": "common.schema.json#/$defs/date" },
        "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source" } },
        "owners": { "type": "array", "items": { "type": "string", "pattern": "^@[A-Za-z0-9_./-]+$" } }
      }
    }
  }
}
