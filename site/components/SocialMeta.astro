---
// Open Graph / Twitter preview tags, shared by the layout and the root redirect page.
// Social previews need an absolute URL that resolves; the configured site domain is not live yet, so use the Railway host.
// Last modified: 2026-09-29T14:10:00+02:00
const { siteName, title, description = '' } = Astro.props;
const PUBLIC_URL = 'https://web-production-ce384.up.railway.app';
const image = new URL('/brand/social-preview.png', PUBLIC_URL).href;
---
<meta property="og:type" content="website" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={new URL(Astro.url.pathname, PUBLIC_URL).href} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="What do you want to happen with AI? Reach out to the people who can actually do something about your concern." />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={image} />
