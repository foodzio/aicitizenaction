---
// A round tinted disc holding one glyph. Decorative: always paired with a text title.
import Icon from './Icon.astro';
const { icon, tone = 'teal', size = 76 } = Astro.props;
---
<span class:list={['aca-disc', `aca-disc-${tone}`]} style={`width:${size}px;height:${size}px`}>
  <Icon name={icon} size={Math.round(size * 0.46)} strokeWidth={2} />
</span>
