---
// Served for any unknown path (serve and most static hosts pick up 404.html).
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { ui } from '../lib/data.mjs';
const t = ui('en');
---
<Base lang="en" title={t('notfound.title')} noindex>
  <div class="narrow">
    <h1>{t('notfound.title')}</h1>
    <p class="lede">{t('notfound.body')}</p>
    <p><Button href="/en/">{t('resources.newcomer_link')} →</Button></p>
    <p><a href="/en/directory/">{t('door.browse')}</a></p>
  </div>
</Base>
