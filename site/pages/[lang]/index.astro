---
// The door: one question, six plain answers, no institution names, no counts (docs/ux-brief.md),
// laid out with the design system: display question, lead, StepMeta, ActionCard grid, ReassuranceNote.
import Base from '../../layouts/Base.astro';
import ActionCard from '../../components/ActionCard.astro';
import StepMeta from '../../components/StepMeta.astro';
import ReassuranceNote from '../../components/ReassuranceNote.astro';
import { data, ui, languages, guideText } from '../../lib/data.mjs';

export const getStaticPaths = () => languages().map(l => ({ params: { lang: l.code } }));
const { lang } = Astro.params;
const t = ui(lang);
const oc = data().guide('outcomes');
const g = guideText('outcomes', lang);
const facts = t('door.shape').split(/\s*·\s*/);
// The addressed "you" in the title is set in the accent colour; falls back to plain text if the word isn't found.
const title = t('door.title');
const emphasis = t('door.title_emphasis');
const at = title.search(new RegExp(`(?<![\\p{L}])${emphasis}(?![\\p{L}])`, 'iu'));
---
<Base lang={lang} current="start" description={t('site.tagline')}>
  <div class="door">
    <h1 class="display">{at < 0 ? title : <>{title.slice(0, at)}<span class="door-you">{title.slice(at, at + emphasis.length)}</span>{title.slice(at + emphasis.length)}</>}</h1>
    <p class="lead">{t('door.lede')}</p>
    <StepMeta steps={3} labelled labels={[t('door.step1'), t('door.step2'), t('door.step3')]} facts={facts} />
    <ul class="aca-grid">
      {oc.facts.outcomes.map(o => (
        <li>
          <ActionCard href={`/${lang}/start/${o.id}/`} icon={o.icon ?? 'document'} tone={o.tone ?? 'teal'}
            title={g(`outcomes.${o.id}.label`)} description={g(`outcomes.${o.id}.hint`)} lang={g.lang(`outcomes.${o.id}.label`)} />
        </li>
      ))}
    </ul>
    <div class="door-foot">
      <ReassuranceNote lead={t('door.trust_lead')}>{t('door.trust_rest')}</ReassuranceNote>
      <p><a href={`/${lang}/directory/`}>{t('door.browse')}</a></p>
    </div>
  </div>
</Base>
<script>
  import { measure } from '../../lib/measure.js';
  measure('door');
</script>
