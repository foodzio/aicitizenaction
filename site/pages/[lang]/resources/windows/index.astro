---
import Base from '../../../../layouts/Base.astro';
import { ui, languages, placeName } from '../../../../lib/data.mjs';
import { resources, isOpen } from '../../../../lib/resources.mjs';

export const getStaticPaths = () => languages().map(l => ({ params: { lang: l.code } }));
const { lang } = Astro.params;
const t = ui(lang);
const { windows } = resources();
const open = windows.filter(w => isOpen(w));
const closed = windows.filter(w => !isOpen(w)).reverse();
---
<Base lang={lang} title={t('resources.windows')} current="resources">
  <h1>{t('resources.windows')}</h1>
  <ul class="routes">
    {open.map(w => <li><a href={`/${lang}/resources/windows/${w.id}/`}><strong>{w.strings.title}</strong></a><div class="meta-line">{placeName(w.facts.jurisdiction, lang)} · {t('resources.closes')} {w.facts.closes_on}</div></li>)}
  </ul>
  {!open.length && <p class="muted">{t('resources.windows_none')}</p>}
  <h2>{t('resources.windows_archive')}</h2>
  <ul class="results">
    {closed.map(w => <li><a href={`/${lang}/resources/windows/${w.id}/`}>{w.strings.title}</a><br /><span class="meta-line">{t('resources.closed')} {w.facts.closes_on}</span></li>)}
  </ul>
</Base>
