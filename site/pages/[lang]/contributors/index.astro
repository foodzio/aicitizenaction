---
// Opt-in only: people with `credit: true` in volunteers/<handle>.yml. No counts, no ranking.
import Base from '../../../layouts/Base.astro';
import { ui, languages, REPO } from '../../../lib/data.mjs';
import { walk, readYaml, ROOT } from '../../../../scripts/lib/content.mjs';
import { join } from 'node:path';

export const getStaticPaths = () => languages().map(l => ({ params: { lang: l.code } }));
const { lang } = Astro.params;
const t = ui(lang);
const people = walk(join(ROOT, 'volunteers')).map(readYaml).filter(v => v?.credit === true).sort((a, b) => a.handle.localeCompare(b.handle));
---
<Base lang={lang} title={t('contributors.title')}>
  <div class="narrow">
    <h1>{t('contributors.title')}</h1>
    <p class="lede">{t('contributors.lede')}</p>
    {people.length ? <ul>{people.map(p => <li>{p.handle}{p.status === 'alumni' ? ' (alumni)' : ''}</li>)}</ul> : <p class="muted">{t('contributors.none')}</p>}
    <p><a href={`${REPO}/issues/new?template=volunteer.yml`} rel="noopener">{t('contributors.volunteer')}</a></p>
  </div>
</Base>
