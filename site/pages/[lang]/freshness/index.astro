---
// A public freshness page: it tells readers how much to trust what they read, and shows
// stewards where the project is thin (docs/content-architecture.md).
import Base from '../../../layouts/Base.astro';
import { ui, languages, placeName } from '../../../lib/data.mjs';
import { freshness } from '../../../../scripts/lib/freshness.mjs';
import { perspectiveLabel } from '../../../lib/resources.mjs';

export const getStaticPaths = () => languages().map(l => ({ params: { lang: l.code } }));
const { lang } = Astro.params;
const t = ui(lang);
const f = freshness();
const sorted = obj => Object.entries(obj).sort((a, b) => a[1].percent - b[1].percent || b[1].total - a[1].total);
const place = c => placeName({ country: c }, lang);
const fill = (value, vars) => Object.entries(vars).reduce((text, [key, item]) => text.replace(`{${key}}`, item), value);
---
<Base lang={lang} title={t('freshness.title')}>
  <div class="narrow">
    <h1>{t('freshness.title')}</h1>
    <p class="lede">{t('freshness.lede')}</p>
    <p><strong>{f.overall.percent}%</strong> {t('freshness.overall')} ({f.overall.current} / {f.overall.total}). {f.seats.overdue} / {f.seats.total} {t('freshness.seats')}.</p>
    <p class="meta-line">{f.now}</p>
  </div>
  <section>
    <h2>{t('freshness.integrity')}</h2>
    <p>{t('freshness.integrity_definition')}</p>
    <dl class="facts">
      <dt>{t('freshness.integrity_entities')}</dt><dd>{f.integrity.canonical_entities}</dd>
      <dt>{t('freshness.integrity_rows')}</dt><dd>{f.integrity.public_directory_rows}</dd>
      <dt>{t('freshness.integrity_redirects')}</dt><dd>{f.integrity.redirects}</dd>
      <dt>{t('freshness.integrity_contacts')}</dt><dd>{f.integrity.contacts.current} / {f.integrity.contacts.total} ({f.integrity.contacts.current_percent}%)</dd>
      <dt>{t('freshness.integrity_excluded')}</dt><dd>{f.integrity.contacts.excluded} / {f.integrity.contacts.total}</dd>
      <dt>{t('freshness.integrity_evidence_age')}</dt><dd>{fill(t('freshness.integrity_age_values'), { median: f.integrity.contacts.evidence_age_days.median ?? '—', oldest: f.integrity.contacts.evidence_age_days.oldest ?? '—' })}</dd>
      <dt>{t('freshness.integrity_coverage')}</dt><dd>{f.integrity.coverage.entities_with_current_contact} / {f.integrity.canonical_entities}</dd>
      <dt>{t('freshness.integrity_places')}</dt><dd>{f.integrity.coverage.countries_with_current_contact}</dd>
      <dt>{t('freshness.integrity_topics')}</dt><dd>{f.integrity.coverage.topics_with_current_contact}</dd>
      <dt>{t('freshness.integrity_identity')}</dt><dd>{fill(t('freshness.integrity_identity_values'), { ...f.integrity.identity.decisions, unresolved: f.integrity.identity.unresolved })}</dd>
      <dt>{t('freshness.integrity_backlog')}</dt><dd>{f.integrity.backlog.total}</dd>
      <dt>{t('freshness.integrity_owners')}</dt><dd>{f.integrity.owner_coverage.covered} / {f.integrity.owner_coverage.total}</dd>
    </dl>
    <h3>{t('freshness.integrity_exclusion_reasons')}</h3>
    <ul>{Object.entries(f.integrity.contacts.exclusion_reasons).sort((a, b) => b[1] - a[1]).map(([reason, count]) => <li><code>{reason}</code>: {count}</li>)}</ul>
  </section>
  {[['by_section', f.bySection, k => t(`directory.sections.${k}`)], ['by_country', f.byCountry, place]].map(([key, obj, label]) => (
    <section>
      <h2>{t(`freshness.${key}`)}</h2>
      <div style="overflow-x:auto" tabindex="0" role="region" aria-label={t(`freshness.${key}`)}>
        <table class="table">
          <thead><tr><th scope="col"><span class="sr-only">{key === 'by_section' ? t('record.type') : t('record.place')}</span></th><th scope="col">{t('freshness.records')}</th><th scope="col">{t('freshness.current')}</th><th scope="col">{t('freshness.overdue')}</th><th scope="col">{t('freshness.unsourced')}</th><th scope="col">%</th></tr></thead>
          <tbody>{sorted(obj).map(([k, v]) => <tr><th scope="row">{label(k)}</th><td>{v.total}</td><td>{v.current}</td><td>{v.overdue}</td><td>{v.unsourced}</td><td>{v.percent}%</td></tr>)}</tbody>
        </table>
      </div>
    </section>
  ))}
  <section class="narrow">
    <h2>{t('freshness.balance')}</h2>
    <h3>{t('freshness.sources')}</h3>
    <ul>{Object.entries(f.balance.sources).sort((a, b) => b[1] - a[1]).map(([k, v]) => <li>{perspectiveLabel(k)}: {v}</li>)}</ul>
    <h3>{t('freshness.published')}</h3>
    <ul>{Object.entries(f.balance.published).sort((a, b) => b[1] - a[1]).map(([k, v]) => <li>{perspectiveLabel(k)}: {v}</li>)}</ul>
    <p class="muted">{f.balance.pending} {t('freshness.pending')}</p>
    <h2>{t('freshness.translations')}</h2>
    {Object.keys(f.translations.languages).length
      ? <ul>{Object.entries(f.translations.languages).map(([l, v]) => <li>{l}: {v.percent}%</li>)}</ul>
      : <p class="muted">{t('freshness.no_translations')}</p>}
  </section>
</Base>
