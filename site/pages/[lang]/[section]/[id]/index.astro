---
// One record: every date beside the fact it applies to, the membership list first-class,
// three-state verification labelled, route language shown before the click.
import Base from '../../../../layouts/Base.astro';
import ContactRoute from '../../../../components/ContactRoute.astro';
import Notice from '../../../../components/Notice.astro';
import { data, ui, languages, placeName, recordStrings, contactCard, isOverdue, SECTIONS } from '../../../../lib/data.mjs';
import { vocabLabel } from '../../../../../scripts/lib/content.mjs';
import { isCurrentSeat } from '../../../../../scripts/lib/routing.mjs';

export function getStaticPaths() {
  const { records } = data();
  return languages().flatMap(l => records.map(r => ({ params: { lang: l.code, section: r._section, id: r.id } })));
}
const { lang, section, id } = Astro.params;
const t = ui(lang);
const { byId, vocab } = data();
const r = byId.get(id);
const s = recordStrings(r, lang);
const text = k => s[k]?.text;
const fieldOrder = ['remit', 'ai_jurisdiction', 'the_ask', 'what_they_do', 'powers_text', 'reality_check', 'realistic',
  'newcomer_action', 'caution', 'business', 'status', 'public_route', 'how', 'format', 'timing', 'after', 'accepts',
  'does_not_accept', 'format_rules', 'agency_route', 'key_people', 'threat_model', 'gov_channel', 'operator', 'tips',
  'geography', 'scale', 'spending', 'language_note', 'notes', 'note'];
const fields = fieldOrder.filter(k => text(k));
const membership = r.facts.routes.find(x => x.type === 'membership' && x.value);
const routes = r.facts.routes.filter(x => x !== membership);
const fallback = Object.values(s).some(x => x.state === 'fallback' || x.state === 'stale') && lang !== 'en';
---
<Base lang={lang} title={text('name')} current="directory">
  <article>
    <div class="record-head">
      <p class="meta-line"><a href={`/${lang}/directory/?section=${section}`}>{t(`directory.sections.${section}`)}</a></p>
      <h1 lang={s.name.lang}>{text('name')}</h1>
      <dl class="facts">
        <dt>{t('record.type')}</dt><dd>{vocabLabel(vocab, 'record-types', r.type)}</dd>
        <dt>{t('record.place')}</dt><dd>{placeName(r.geo, lang)}{r.geo.label && r.geo.label !== placeName(r.geo, lang) ? ` — ${r.geo.label}` : ''}</dd>
        {r.facts.local_name && <><dt>{t('record.local_name')}</dt><dd>{r.facts.local_name}</dd></>}
        <dt>{t('record.last_checked')}</dt><dd>{r.meta.verified_on}</dd>
        <dt>{t('record.review_by')}</dt><dd>{r.meta.review_by}</dd>
      </dl>
      {isOverdue(r) && <Notice tone="caution">{t('verify.overdue')} {r.meta.review_by}.</Notice>}
      {r.meta.unsourced && <Notice tone="blocking">{t('verify.unsourced')}</Notice>}
      {section === 'channels' && r.facts.contact_disposition !== 'keep' && <Notice tone="information">{t('record.not_contact')}</Notice>}
      {fallback && <Notice tone="information">{t('site.translation_fallback')}</Notice>}
    </div>

    {r.facts.seats?.length > 0 && (
      <section>
        <h2>{t('record.seats')}</h2>
        <ul class="seats">
          {r.facts.seats.map(x => (
            <li><strong>{x.name}</strong> — {x.role}{x.party && `, ${x.party}`}{x.region && `, ${x.region}`} <span class="meta-line">· {t('path.checked')} {x.verified_on}</span>{!isCurrentSeat(x) && <> <span class="badge v-false">{t('verify.expired')}</span></>}</li>
          ))}
        </ul>
        {membership && <p><a href={membership.value} target="_blank" rel="noopener noreferrer">{t('path.membership')}</a> <span class={`badge v-${membership.verified}`}>{t(`verify.${membership.verified}`)}</span></p>}
      </section>
    )}

    <section>
      <h2>{t('record.routes')}</h2>
      <ul class="routes">
        {(r.facts.seats?.length ? routes : r.facts.routes).map(x => {
          const c = contactCard(r, x, lang);
          return <li><ContactRoute contract={c.contract} recipient={c.recipient} routeLabel={c.label} typeLabel={c.type} language={c.language} scope={c.scope} note={c.note} t={t} /></li>;
        })}
      </ul>
    </section>

    <section class="prose">
      {fields.map(k => (<><h2>{t(`record.fields.${k}`)}</h2>{text(k).split(/\n\n+/).map(p => <p lang={s[k].lang}>{p}</p>)}</>))}
    </section>

    {r.meta.sources?.length > 0 && (
      <section>
        <h2>{t('record.sources')}</h2>
        <ul>{r.meta.sources.map(x => <li><a href={x.url} target="_blank" rel="noopener noreferrer">{x.url}</a>{x.checked && <span class="meta-line"> · {x.checked}</span>}</li>)}</ul>
      </section>
    )}
    <p><a href={`/${lang}/feedback/?topic=wrong&page=${encodeURIComponent(`/${lang}/${section}/${id}/`)}`}>{t('record.report')}</a></p>
  </article>
</Base>
