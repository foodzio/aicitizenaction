---
// The path: narrow → why this one → draft → done (docs/ux-brief.md, "The primary flow").
// Routing is precomputed at build time for every place; the browser only switches views.
// Every state has a URL (?where=us&sub=ca&to=<id>&step=3), so a link can open mid-path.
import Base from '../../../../layouts/Base.astro';
import StepMeta from '../../../../components/StepMeta.astro';
import { data, ui, languages, outcomePayload, placeOptions, guideText, recordUrl } from '../../../../lib/data.mjs';

export function getStaticPaths() {
  const oc = data().guide('outcomes').facts.outcomes;
  return languages().flatMap(l => oc.map(o => ({ params: { lang: l.code, outcome: o.id } })));
}
const { lang, outcome: outcomeId } = Astro.params;
const t = ui(lang);
const { guide } = data();
const oc = guide('outcomes');
const outcome = oc.facts.outcomes.find(o => o.id === outcomeId);
const go = guideText('outcomes', lang);
const gi = guideText('insider', lang);
const gt = guideText('draft-templates', lang);
const label = go(`outcomes.${outcomeId}.label`);
const insider = guide('insider');
const tpl = guide('draft-templates');
const places = placeOptions(lang);

const keys = ['path.step', 'path.of', 'path.floor_bloc', 'path.floor_global', 'path.none', 'path.can_do', 'path.leverage',
  'path.how_reach', 'path.people', 'path.checked', 'path.membership', 'path.details', 'path.choose', 'path.chosen',
  'path.copied', 'path.copy', 'verify.true', 'verify.false', 'verify.null', 'verify.true_hint', 'verify.false_hint',
  'verify.null_hint', 'verify.language', 'verify.overdue', 'path.own_words_missing', 'path.method_link', 'path.step4', 'door.step1', 'door.step2', 'door.step3',
  'contact.recipient', 'contact.eligible', 'contact.accepts', 'contact.restrictions', 'contact.mechanism', 'contact.evidence', 'contact.checked', 'contact.why', 'contact.unavailable',
  ...['verified', 'unverified', 'expired', 'closed', 'unusable', 'reference_only'].flatMap(x => [`contact.state.${x}`, `contact.state.${x}_help`]),
  ...['email', 'phone', 'details', 'consultation', 'submission', 'report', 'petition', 'feedback', 'form'].map(x => `contact.actions.${x}`),
  ...['public', 'users-meeting-published-eligibility', 'users-following-published-instructions'].map(x => `contact.audience.${x}`),
  ...['audit', 'behaviour', 'bounty', 'complaint', 'consultation', 'disclosure', 'email', 'feedback', 'flaw', 'form', 'fund', 'harm', 'insider', 'join', 'law', 'opposition', 'petition', 'record', 'reporting', 'research', 'submission', 'systemic', 'tip', 'whistleblowing'].map(x => `contact.subjects.${x}`)];
const payload = outcome.stop ? null : {
  lang,
  outcome: { id: outcome.id, ignoreGeo: !!outcome.ignore_geo && outcome.ask !== 'company', ask: outcome.ask ?? null },
  byPlace: outcomePayload(outcome, lang),
  template: gt(`templates.${outcome.template}`),
  floorTemplate: gt('templates.international'),
  methodUrl: (m => m ? recordUrl(lang, m) : null)(data().records.find(r => r.facts.recommend === false && r.geo.country === 'global')),
  t: Object.fromEntries(keys.map(k => [k, t(k)]))
};
const steps = [t('door.step1'), t('door.step2'), t('door.step3')];
---
<Base lang={lang} title={label} current="start" draft={oc.meta.status === 'draft' || tpl.meta.status === 'draft'}>
  <div class="narrow">
    <p><a href={`/${lang}/`}>← {t('path.back')}</a></p>
    <h1>{label}</h1>

    {outcome.stop ? (
      <section>
        <h2>{gi('title')}</h2>
        {gi('body').trim().split(/\n\n+/).map(p => <p>{p}</p>)}
        <p><a class="btn secondary" href={`/${lang}/`}>{gi('back')}</a></p>
      </section>
    ) : (
      <div id="path">
        <div class="path-steps">
          <StepMeta steps={3} current={1} labels={steps} />
          <p class="meta-line" id="step-label" aria-live="polite"></p>
        </div>
        <noscript><p class="notice">{t('path.no_js')} <a href={`/${lang}/directory/`}>{t('site.nav_directory')}</a></p></noscript>

        {outcome.ask === 'company' ? (
        <section data-step="1" hidden>
          <h2>{t('path.which_company')}</h2>
          <p class="hint">{t('path.which_company_hint')}</p>
          <label for="company">{t('path.which_company')}</label>
          <select id="company">
            <option value="">{t('path.company_unsure')}</option>
            {payload.byPlace[''].recipients.filter(r => r.isCompany).sort((a, b) => a.name.localeCompare(b.name)).map(r => <option value={r.id}>{r.name}</option>)}
          </select>
          <div class="row"><button class="btn" type="button" data-go="2">{t('path.show')}</button></div>
        </section>
        ) : (
        <section data-step="1" hidden>
          <h2>{t('path.where_question')}</h2>
          <p class="hint">{t('path.where_hint')}</p>
          <label for="where">{t('path.where_question')}</label>
          <select id="where">
            <option value="">{t('path.where_skip')}</option>
            {places.countries.map(c => <option value={c.code}>{c.name}</option>)}
            <option value="zz">{t('path.where_any')}</option>
          </select>
          <div id="sub-wrap" hidden>
            <label for="sub">{t('path.where_state')}</label>
            <select id="sub">
              <option value="">—</option>
              {places.states.map(s => <option value={s.code}>{s.name}</option>)}
            </select>
          </div>
          <div class="row"><button class="btn" type="button" data-go="2">{t('path.show')}</button></div>
        </section>
        )}

        <section data-step="2" hidden>
          <h2>{t('path.why_title')}</h2>
          <p class="notice" id="floor" hidden></p>
          <div id="primary"></div>
          <div id="alts-wrap" hidden>
            <h3>{t('path.alternatives')}</h3>
            <div class="alt" id="alts"></div>
          </div>
          <div class="row">
            <button class="btn" type="button" data-go="3" id="to-draft">{t('path.write')}</button>
            <button class="btn secondary" type="button" data-back>{t('path.back')}</button>
          </div>
        </section>

        <section data-step="3" hidden>
          <h2><label for="own" style="margin:0;font-weight:inherit">{t('path.own_words_title')}</label></h2>
          <p class="hint">{gt('own_words_why')}</p>
          <textarea id="own" rows="4" placeholder={gt('own_words_placeholder')}></textarea>

          <h2><label for="draft" style="margin:0;font-weight:inherit">{t('path.draft_title')}</label></h2>
          <p class="hint">{t('path.draft_hint')}</p>
          <textarea id="draft" class="draft"></textarea>

          <h3>{t('path.send_to')}</h3>
          <div id="send-to"></div>
          <div class="row">
            <button class="btn" type="button" id="copy">{t('path.copy')}</button>
            <button class="btn secondary" type="button" id="download">{t('path.download')}</button>
          </div>
          <h3>{t('path.next_title')}</h3>
          <p>{t('path.next_default')}</p>
          <div class="row">
            <button class="btn" type="button" data-go="4">{t('path.done_title').split('—')[0].trim()} →</button>
            <button class="btn secondary" type="button" data-back>{t('path.back')}</button>
          </div>
        </section>

        <section data-step="4" hidden>
          <h2>{t('path.done_title')}</h2>
          <p>{t('path.done_body')}</p>
          <h3>{t('path.done_next')}</h3>
          <p>{t('path.done_share')}</p>
          <p><input type="text" id="share" readonly aria-label={t('path.done_share')} /></p>
          <p><a href={`/${lang}/`}>{t('path.start_over')}</a></p>
        </section>

        <script type="application/json" id="payload" set:html={JSON.stringify(payload)} />
      </div>
    )}
  </div>
</Base>

<script>
  import { measure } from '../../../../lib/measure.js';

  const el = document.getElementById('payload');
  if (el) {
    const P = JSON.parse(el.textContent);
    const T = P.t;
    const $ = s => document.querySelector(s);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const sections = [...document.querySelectorAll('[data-step]')];
    const firstStep = P.outcome.ignoreGeo ? 2 : 1;
    const state = { where: '', sub: '', company: '', to: '', step: firstStep, own: '', draftEdited: false };

    const q = new URLSearchParams(location.search);
    state.where = q.get('where') ?? '';
    state.sub = q.get('sub') ?? '';
    state.to = q.get('to') ?? '';
    state.company = q.get('company') ?? '';
    state.step = Math.max(firstStep, Math.min(4, Number(q.get('step')) || firstStep));
    if ($('#where')) { $('#where').value = state.where; $('#sub').value = state.sub; }
    if ($('#company')) $('#company').value = state.company;

    const result = () => {
      if (P.outcome.ask === 'company') {
        // The chosen company first, then independent channels (incident databases, watchdogs).
        const all = P.byPlace[''].recipients;
        const company = all.find(x => x.id === state.company);
        const independent = all.filter(x => !x.isCompany).slice(0, 2);
        return { ...P.byPlace[''], recipients: company ? [company, ...independent] : independent };
      }
      if (P.outcome.ignoreGeo) return P.byPlace[''];
      const key = state.sub && state.where === 'us' ? `us/${state.sub}` : state.where;
      return P.byPlace[key] ?? P.byPlace[state.where] ?? (state.where ? P.byPlace.zz : P.byPlace['']) ?? P.byPlace[''];
    };
    const chosen = () => { const r = result(); return r.recipients.find(x => x.id === state.to) ?? r.recipients[0]; };

    function contactHtml(c) {
      if (!c) return '';
      const k = c.contract, state = k.state, mechanism = k.mechanism, evidence = k.evidence;
      const term = (group, value) => T[`contact.${group}.${value}`] || value.replaceAll('-', ' ');
      const list = (group, values) => values?.length ? values.map(x => term(group, x)).join('; ') : '';
      const badge = `<span class="badge contact-status contact-status-${esc(state.state)}" title="${esc(T[`contact.state.${state.state}_help`])}" data-ds-component="status-badge" data-contact-state="${esc(state.state)}"><span class="contact-status-icon" aria-hidden="true">✓</span><span>${esc(T[`contact.state.${state.state}`])}</span>${evidence.checkedOn ? `<span class="contact-status-date"> · ${esc(evidence.checkedOn)}</span>` : ''}</span>`;
      const facts = [
        [T['contact.recipient'], c.recipient],
        [T['contact.eligible'], list('audience', k.audience)],
        [T['contact.accepts'], list('subjects', k.acceptedSubjects)],
        [T['contact.restrictions'], k.restrictions],
        [T['contact.mechanism'], state.actionable ? mechanism.value : '']
      ].filter(([, value]) => value).map(([label, value]) => `<dt>${esc(label)}</dt><dd>${esc(value)}</dd>`).join('');
      const external = mechanism.href?.startsWith('http');
      const action = state.actionable
        ? mechanism.href
          ? `<div class="contact-route-action" data-contact-action="primary"><a class="btn" href="${esc(mechanism.href)}"${external ? ' target="_blank" rel="noopener noreferrer"' : ''} data-ds-component="button" data-variant="primary">${esc(T[`contact.actions.${mechanism.actionKind}`])}</a></div>`
          : `<div class="notice notice-information" role="note" data-ds-component="notice" data-tone="information"><strong>${esc(T['contact.actions.details'])}</strong><br>${esc(mechanism.value)}</div>`
        : `<div class="notice notice-caution" role="note" data-ds-component="notice" data-tone="caution"><strong>${esc(T[`contact.state.${state.state}`])}.</strong> ${esc(T[`contact.state.${state.state}_help`])} ${esc(T['contact.unavailable'])}</div>`;
      const evidenceNotes = [...new Set([evidence.note, c.scope, c.note].filter(Boolean))];
      const evidenceBlock = evidence.url || evidenceNotes.length ? `<aside class="contact-route-evidence" aria-label="${esc(T['contact.evidence'])}: ${esc(c.label || c.type)}" data-contact-evidence="true"><h4>${esc(T['contact.evidence'])}</h4>${evidenceNotes.map(value => `<p>${esc(value)}</p>`).join('')}${evidence.url ? `<p><a href="${esc(evidence.url)}" target="_blank" rel="noopener noreferrer">${esc(T['contact.why'])}</a>${evidence.checkedOn ? `<span class="meta-line"> · ${esc(T['contact.checked'])} ${esc(evidence.checkedOn)}</span>` : ''}</p>` : ''}</aside>` : '';
      return `<article class="contact-route ${state.actionable ? 'contact-route-actionable' : 'contact-route-reference'}" data-ds-component="contact-route" data-contact-state="${esc(state.state)}" data-contact-reason="${esc(state.reason)}" data-actionable="${state.actionable}" data-record-id="${esc(k.recordId)}" data-route-id="${esc(k.routeId)}"><header class="contact-route-head"><div><h3>${esc(c.label || c.type)}</h3><p class="meta-line">${esc(c.type)}${c.language ? ` · ${esc(T['verify.language'])}: ${esc(c.language)}` : ''}</p></div>${badge}</header><dl class="contact-route-facts">${facts}</dl>${action}${evidenceBlock}</article>`;
    }
    function cardHtml(r, primary) {
      const seats = r.seats.length ? `<dt>${esc(T['path.people'])}</dt><dd>${r.seats.map(s => `${esc(s.name)} (${esc(s.role)}${s.party ? ', ' + esc(s.party) : ''}${s.region ? ', ' + esc(s.region) : ''}) <span class="meta-line">· ${esc(T['path.checked'])} ${esc(s.verifiedOn)}</span>`).join('<br>')}${r.membership ? `<br><a href="${esc(r.membership)}" target="_blank" rel="noopener noreferrer">${esc(T['path.membership'])}</a>` : ''}</dd>` : '';
      return `<article class="card${primary ? ' primary' : ''}">
        <h3>${esc(r.name)}</h3>
        <p class="meta-line">${esc(r.type)} · ${esc(r.place)} · ${esc(T['path.checked'])} ${esc(r.checked)}${r.overdue ? ` · ${esc(T['verify.overdue'])} ${esc(r.checked)}` : ''}</p>
        <dl>
          ${r.canDo ? `<div><dt>${esc(T['path.can_do'])}</dt><dd>${esc(r.canDo)}</dd></div>` : ''}
          ${r.leverage ? `<div><dt>${esc(T['path.leverage'])}</dt><dd>${esc(r.leverage)}</dd></div>` : ''}
          <div><dt>${esc(T['path.how_reach'])}</dt><dd>${r.how ? esc(r.how) + '<br>' : ''}${contactHtml(r.contact)}</dd></div>
          ${seats ? `<div>${seats}</div>` : ''}
        </dl>
        <p class="meta-line"><a href="${esc(r.url)}">${esc(T['path.details'])}</a></p>
      </article>`;
    }

    function renderRecipients() {
      const r = result();
      const floor = $('#floor');
      floor.hidden = !(r.floor || !r.recipients.length);
      floor.textContent = !r.recipients.length ? T['path.none'] : r.scope === 'bloc' ? T['path.floor_bloc'] : T['path.floor_global'];
      if (r.scope === 'global' && P.methodUrl) {
        const a = document.createElement('a'); a.href = P.methodUrl; a.textContent = T['path.method_link'];
        floor.append(' ', a);
      }
      const c = chosen();
      $('#to-draft').disabled = !c;
      $('#primary').innerHTML = c ? cardHtml(c, true) : '';
      const alts = r.recipients.filter(x => x !== c);
      $('#alts-wrap').hidden = !alts.length;
      $('#alts').innerHTML = alts.map(x => `<button type="button" data-pick="${esc(x.id)}" aria-pressed="false"><strong>${esc(x.name)}</strong><br><span class="meta-line">${esc(x.type)} · ${esc(x.place)}</span></button>`).join('');
    }

    function fill() {
      const c = chosen();
      const own = state.own.trim() || T['path.own_words_missing'];
      const tpl = result().scope === 'global' && P.floorTemplate && !P.floorTemplate.startsWith('templates.') ? P.floorTemplate : P.template;
      return tpl.replace(/\{recipient\}/g, c?.recipient ?? '').replace(/\{own_words\}/g, own);
    }
    function renderDraft() {
      if (!state.draftEdited) $('#draft').value = fill();
      const c = chosen();
      $('#send-to').innerHTML = c ? `<div class="card">${contactHtml(c.contact)}</div>` : '';
    }

    let depth = 0;                                   // steps pushed onto history by this page
    function syncUrl(push) {
      if (push) depth++;
      const p = new URLSearchParams();
      if (state.where) p.set('where', state.where);
      if (state.sub) p.set('sub', state.sub);
      if (state.company) p.set('company', state.company);
      if (state.to) p.set('to', state.to);
      if (state.step !== firstStep) p.set('step', state.step);
      const url = `${location.pathname}${p.toString() ? '?' + p : ''}`;
      history[push ? 'pushState' : 'replaceState']({ ...state }, '', url);
    }

    function show(step, push = true) {
      state.step = step;
      sections.forEach(s => { s.hidden = Number(s.dataset.step) !== step; });
      document.querySelectorAll('.path-steps [data-p]').forEach(d => {
        const n = Number(d.dataset.p);
        d.classList.toggle('is-future', n > step);
        if (n === step) d.setAttribute('aria-current', 'step'); else d.removeAttribute('aria-current');
      });
      // Three steps; step 4 is the finished state: every disc complete, labelled "Done".
      $('#step-label').textContent = step > 3 ? T['path.step4'] : `${T['path.step']} ${step} ${T['path.of']} 3 · ${T['door.step' + step]}`;
      if (step === 2) renderRecipients();
      if (step === 3) renderDraft();
      syncUrl(push);
      if (step === 4) {
        const s = new URL(location.href);
        s.searchParams.delete('to');
        s.searchParams.set('step', s.searchParams.get('where') || s.searchParams.get('company') ? '2' : '1');
        if (s.searchParams.get('step') === '1') s.searchParams.delete('step');
        $('#share').value = s.href;
      }
      measure('path_step', { outcome: P.outcome.id, step });
      const h = sections.find(s => !s.hidden)?.querySelector('h2');
      if (h && push) { h.setAttribute('tabindex', '-1'); h.focus(); }
    }

    if ($('#where')) {
      $('#where').addEventListener('change', e => { state.where = e.target.value; state.to = ''; $('#sub-wrap').hidden = state.where !== 'us'; if (state.where !== 'us') state.sub = ''; });
      $('#sub').addEventListener('change', e => { state.sub = e.target.value; state.to = ''; });
      $('#sub-wrap').hidden = state.where !== 'us';
    }
    if ($('#company')) $('#company').addEventListener('change', e => { state.company = e.target.value; state.to = ''; });
    document.addEventListener('click', e => {
      const go = e.target.closest('[data-go]');
      if (go) { show(Number(go.dataset.go)); if (go.dataset.go === '4') measure('path_done', { outcome: P.outcome.id }); }
      if (e.target.closest('[data-back]')) { if (depth > 0) history.back(); else show(Math.max(firstStep, state.step - 1)); }
      const pick = e.target.closest('[data-pick]');
      if (pick) { state.to = pick.dataset.pick; state.draftEdited = false; renderRecipients(); syncUrl(false); measure('recipient_chosen', { recipient: state.to }); }
    });
    $('#own').addEventListener('input', e => { state.own = e.target.value; renderDraft(); });
    $('#draft').addEventListener('input', () => { state.draftEdited = true; });
    const done = kind => measure(kind, { outcome: P.outcome.id, place: state.sub ? `${state.where}/${state.sub}` : state.where, recipient: chosen()?.id, own_words: state.own.trim().length > 0 });
    $('#copy').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText($('#draft').value); } catch { $('#draft').select(); document.execCommand('copy'); }
      $('#copy').textContent = T['path.copied'];
      setTimeout(() => { $('#copy').textContent = T['path.copy']; }, 2000);
      done('draft_copied');
    });
    $('#download').addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([$('#draft').value], { type: 'text/plain;charset=utf-8' }));
      a.download = 'message.txt';
      a.click();
      URL.revokeObjectURL(a.href);
      done('draft_downloaded');
    });
    window.addEventListener('popstate', e => {
      depth = Math.max(0, depth - 1);
      if (e.state) { Object.assign(state, e.state); show(state.step, false); }
      else show(firstStep, false);
    });
    show(state.step, false);
  }
</script>
