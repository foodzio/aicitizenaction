---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { ui, languages } from '../lib/data.mjs';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { ROOT } from '../../scripts/lib/content.mjs';

const { lang = 'en', title, description = '', current = '', draft = false, noindex = false } = Astro.props;
const t = ui(lang);
const langs = languages();
const thisLang = langs.find(l => l.code === lang);
const hide = noindex || !thisLang?.public;
const version = JSON.parse(readFileSync(join(ROOT, 'version.json'), 'utf8')).version;
const path = Astro.url.pathname.replace(/^\/[a-z]{2,3}\//, '/');
// Languages offered in the header dropdown: every public one, plus the current page's own.
const menuLangs = langs.filter(l => l.public || l.code === lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${t('site.name')}` : t('site.name')}</title>
    {description && <meta name="description" content={description} />}
    {hide && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/brand/aicitizenaction-mark.png" type="image/png" />
    {!hide && <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />}
    {!hide && langs.filter(l => l.public).map(l => <link rel="alternate" hreflang={l.code} href={new URL(`/${l.code}${path}`, Astro.site)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t('site.skip')}</a>
    <header class="aca-header">
      <div class="wrap">
        <a class="aca-header-logo" href={`/${lang}/`} aria-label={t('site.name')}>
          <img src="/brand/aicitizenaction-lockup.png" alt="" width="274" height="40" />
          <span class="aca-header-name" aria-hidden="true">AICitizen<em>Action</em>.org</span>
        </a>
        <div class="aca-header-bar">
        <nav class="aca-header-nav" aria-label="Main">
          <a class:list={['aca-nav-link', current === 'start' && 'is-active']} href={`/${lang}/`} aria-current={current === 'start' ? 'page' : undefined}>{t('site.nav_start')}</a>
          <a class:list={['aca-nav-link', current === 'resources' && 'is-active']} href={`/${lang}/resources/`} aria-current={current === 'resources' ? 'page' : undefined}>{t('site.nav_resources')}</a>
          <a class:list={['aca-nav-link', current === 'directory' && 'is-active']} href={`/${lang}/directory/`} aria-current={current === 'directory' ? 'page' : undefined}>{t('site.nav_directory')}</a>
          <a class:list={['aca-nav-link', current === 'about' && 'is-active']} href={`/${lang}/about/`} aria-current={current === 'about' ? 'page' : undefined}>{t('site.nav_about')}</a>
          <a class:list={['aca-nav-link', current === 'involved' && 'is-active']} href={`/${lang}/get-involved/`} aria-current={current === 'involved' ? 'page' : undefined}>{t('site.nav_involved')}</a>
        </nav>
        <div class="aca-header-utils">
          <a class="aca-header-utility" href={`/${lang}/about/#privacy`}><Icon name="lock" size={18} />{t('site.nav_privacy')}</a>
        </div>
        </div>
        {menuLangs.length > 1 && (
          <details class="aca-lang">
            <summary aria-label={`${t('site.language')}: ${thisLang?.name ?? lang}`}>
              <span class="aca-lang-name" lang={lang}>{thisLang?.name ?? lang}</span>
              <span class="aca-lang-code" aria-hidden="true">{lang.toUpperCase()}</span>
              <svg class="aca-lang-chevron" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </summary>
            <ul class="aca-lang-menu">
              {menuLangs.map(l => (
                <li><a href={`/${l.code}${path}`} lang={l.code} hreflang={l.code} aria-current={l.code === lang ? 'true' : undefined}>{l.name}</a></li>
              ))}
            </ul>
          </details>
        )}
      </div>
    </header>
    <main id="main">
      <div class="wrap">
        {lang !== 'en' && !thisLang?.public && <p class="notice" lang={lang}>{t('site.translation_machine')}</p>}
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <p>{t('site.footer_note')}</p>
        <p>
          <a href={`/${lang}/feedback/`}>{t('site.footer_feedback')}</a> · <a href={`/${lang}/freshness/`}>{t('site.footer_freshness')}</a> · <a href={`/${lang}/contributors/`}>{t('contributors.footer')}</a> · {t('site.footer_version')} {version}
        </p>
      </div>
    </footer>
    <script define:vars={{ newTab: t('site.new_tab') }}>
      // Links to other websites open in a new tab, with a note for screen readers. Covers links in
      // the page and any the guided path builds later. Email and same-site links are untouched.
      const mark = a => {
        if (a.dataset.ext || !/^https?:$/.test(a.protocol) || a.host === location.host) return;
        a.dataset.ext = '1';
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        const s = document.createElement('span'); s.className = 'sr-only'; s.textContent = ` ${newTab}`;
        a.append(s);
      };
      document.querySelectorAll('a[href]').forEach(mark);
      new MutationObserver(ms => ms.forEach(m => m.addedNodes.forEach(n => {
        if (n.nodeType !== 1) return;
        if (n.matches?.('a[href]')) mark(n);
        n.querySelectorAll?.('a[href]').forEach(mark);
      }))).observe(document.body, { childList: true, subtree: true });
    </script>
    <script>
      // The language menu is a <details>: it works without JavaScript; this only closes it on an
      // outside click or Escape, as a dropdown should.
      const lm = document.querySelector('.aca-lang');
      if (lm) {
        document.addEventListener('click', e => { if (lm.open && !lm.contains(e.target)) lm.open = false; });
        document.addEventListener('keydown', e => { if (e.key === 'Escape' && lm.open) { lm.open = false; lm.querySelector('summary').focus(); } });
      }
    </script>
  </body>
</html>
