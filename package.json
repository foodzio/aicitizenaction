{
  "name": "aicitizenaction",
  "version": "0.1.75",
  "private": true,
  "type": "module",
  "description": "Routes an alarmed non-expert to the one institution that can act on their AI concern, and hands them a draft.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "migrate": "node scripts/migrate-input.mjs",
    "validate": "node scripts/validate.mjs",
    "contact-audit": "node scripts/contact-audit.mjs",
    "contact-review": "node scripts/apply-contact-review.mjs",
    "directory-dedupe": "node scripts/directory-dedupe.mjs",
    "directory-identity-review": "node scripts/directory-identity-review.mjs",
    "directory-identity-apply": "node scripts/apply-identity-decisions.mjs",
    "directory-audit": "node scripts/directory-audit.mjs",
    "directory-audit:full": "node scripts/directory-audit.mjs --full",
    "directory-issues": "node scripts/file-directory-issues.mjs tmp/directory-audit/report.json --dry-run",
    "directory-sample": "node scripts/monthly-route-sample.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run validate && npm test",
    "dev": "astro dev",
    "build": "astro build && node scripts/build-redirects.mjs && node scripts/build-directory-validity.mjs",
    "preview": "astro preview",
    "start": "node server.mjs",
    "serve": "npm run build && node server.mjs",
    "feedback": "node scripts/read-feedback.mjs"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.4",
    "serve": "14.2.6",
    "serve-handler": "6.1.7",
    "tldts": "7.4.15",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "axe-core": "4.13.0"
  }
}
